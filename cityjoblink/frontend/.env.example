# Optional: override API endpoint used by frontend fetch requests.
# For same-machine local setup, default fallback is http://<current-host>:8000/api.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Optional: base URL for backend-hosted files (resume/doc links).
# If omitted, it is derived from VITE_API_BASE_URL by removing /api.
VITE_BACKEND_BASE_URL=http://127.0.0.1:8000
